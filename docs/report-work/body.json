n": "left", "bold": "false", "fill": "FFFFFF", "color": "000000", "padding.top": "0.13cm", "padding.bottom": "0.13cm", "padding.left": "0.16cm", "padding.right": "0.16cm"}}, {"command": "set", "path": "/body/tbl[1]/tr[9]/tc[1]", "props": {"text": "项目目录", "font": "宋体", "size": "10pt", "valign": "center", "align": "left", "bold": "false", "fill": "F7F8F6", "color": "000000", "padding.top": "0.13cm", "padding.bottom": "0.13cm", "padding.left": "0.16cm", "padding.right": "0.16cm"}}, {"command": "set", "path": "/body/tbl[1]/tr[9]/tc[2]", "props": {"text": "Code/memory-game6085/", "font": "宋体", "size": "10pt", "valign": "center", "align": "left", "bold": "false", "fill": "F7F8F6", "color": "000000", "padding.top": "0.13cm", "padding.bottom": "0.13cm", "padding.left": "0.16cm", "padding.right": "0.16cm"}}, {"command": "set", "path": "/body/tbl[1]/tr[10]/tc[1]", "props": {"text": "访问与数据", "font": "宋体", "size": "10pt", "valign": "center", "align": "left", "bold": "false", "fill": "FFFFFF", "color": "000000", "padding.top": "0.13cm", "padding.bottom": "0.13cm", "padding.left": "0.16cm", "padding.right": "0.16cm"}}, {"command": "set", "path": "/body/tbl[1]/tr[10]/tc[2]", "props": {"text": "http://localhost:8080；data/garden.db", "font": "宋体", "size": "10pt", "valign": "center", "align": "left", "bold": "false", "fill": "FFFFFF", "color": "000000", "padding.top": "0.13cm", "padding.bottom": "0.13cm", "padding.left": "0.16cm", "padding.right": "0.16cm"}}, {"command": "add", "parent": "/body", "type": "paragraph", "props": {"text": "源码由 frontend、backend 和 scripts 构成。Dockerfile、compose.yaml 和 README.md 位于项目根目录。原始要求保留在 raw/，工作过程和验证结果记录在 docs/。", "style": "Normal", "font": "宋体", "size": "11pt", "color": "000000", "spaceAfter": "7pt", "lineSpacing": "1.3x"}}, {"command": "add", "parent": "/body", "type": "paragraph", "props": {"text": "三 系统设计与持久化", "style": "Heading1", "font": "黑体", "size": "18pt", "color": "000000", "spaceAfter": "10pt", "lineSpacing": "1.3x", "bold": "true", "spaceBefore": "12pt", "keepNext": "true", "pageBreakBefore": "false"}}, {"command": "add", "parent": "/body", "type": "paragraph", "props": {"text": "浏览器页面由 Vue3 实现，Spring Boot 提供牌局、翻牌、暂停、成绩提交和排行榜接口。Vue 构建后的静态资源打入同一个可执行 JAR，部署时只需一个应用容器。SQLite 以数据库文件保存成绩，不需要独立数据库服务。", "style": "Normal", "font": "宋体", "size": "11pt", "color": "000000", "spaceAfter": "7pt", "lineSpacing": "1.3x"}}, {"command": "add", "parent": "/body", "type": "paragraph", "props": {"text": "游戏提供轻松 6 对、标准 8 对和挑战 12 对卡牌。牌面随机顺序、配对判断、步数与计时均由后端处理，未翻开的答案不发给前端。运行中的牌局保存在内存，服务重启后不恢复；已提交成绩保存在 SQLite。", "style": "Normal", "font": "宋体", "size": "11pt", "color": "000000", "spaceAfter": "7pt", "lineSpacing": "1.3x"}}, {"command": "add", "parent": "/body", "type": "paragraph", "props": {"text": "成绩表包含牌局唯一标识、昵称、难度、步数、用时和创建时间。相同牌局重复提交只保留一条记录。排行榜按难度分别查询，优先比较步数，步数相同时比较用时。容器方案将数据库目录 /app/data 挂载到命名数据卷 memory-game6085-data。", "style": "Normal", "font": "宋体", "size": "11pt", "color": "000000", "spaceAfter": "7pt", "lineSpacing": "1.3x"}}, {"command": "add", "parent": "/body", "type": "paragraph", "props": {"text": "四 本地构建与功能验证", "style": "Heading1", "font": "黑体", "size": "18pt", "color": "000000", "spaceAfter": "10pt", "lineSpacing": "1.3x", "bold": "true", "spaceBefore": "12pt", "keepNext": "true", "pageBreakBefore": "true"}}, {"command": "add", "parent": "/body", "type": "paragraph", "props": {"text": "4.1 构建与启动", "style": "Heading2", "font": "黑体", "size": "14pt", "color": "000000", "spaceAfter": "10pt", "lineSpacing": "1.3x", "bold": "true", "spaceBefore": "12pt", "keepNext": "true", "pageBreakBefore": "false"}}, {"command": "add", "parent": "/body", "type": "paragraph", "props": {"text": "以下命令在项目根目录执行。本地构建已成功；构建前应先停止占用目标 JAR 的应用进程。", "style": "Normal", "font": "宋体", "size": "11pt", "color": "000000", "spaceAfter": "7pt", "lineSpacing": "1.3x"}}, {"command": "add", "parent": "/body", "type": "paragraph", "props": {"text": ".\\scripts\\build.ps1", "style": "Normal", "font": "Consolas", "size": "9pt", "color": "000000", "spaceA