# Local dependencies and temporary execution state
**/node_modules/
**/.qa/
**/__pycache__/
*.py[cod]
**/.idea/
**/.vscode/

# Local environment and credentials
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx

# Operating-system and Office temporary files
.DS_Store
Thumbs.db
~$*

# Reproducible v2 working copies; canonical deliverables are in output/v2.
/docs/v2-code-work/*.zip
/docs/v2-evidence-work/*.zip
/docs/v2-report-work/*.docx
/docs/v2-report-work/contact-pass*.png
/docs/v2-report-work/render-pass*/
/docs/v2-report-work/render-final/
/docs/v2-report-work/render-font-check/
/docs/v2-report-work/render-layout-check/

# Reproducible v3 working copies; final deliverables and final visual QA remain.
/docs/v3-work/*.zip
/docs/v3-report-work/*.docx
/docs/v3-report-work/render-first/
/docs/v3-report-work/render-layout/
/docs/v3-evidence/*-pid.txt
/docs/v3-evidence/*-launch.log
/docs/v3-evidence/Xorg.*.log

# Reproducible v4 working copies; retain final page renders and verification.
/docs/v4-work/*.zip
/docs/v4-report-work/*.docx
/docs/v4-report-work/render-first/
/docs/v4-report-work/render-layout/

# Local test copies and transient runtime state; keep original logs and evidence.
/docs/local-test-20261022/unpacked/
/docs/local-test-20261022/*.docx
/docs/local-test-20261022/deliverable-db/
/docs/local-test-20261022/docker-roundtrip/source-image-app.jar
/docs/local-test-20261022/ui-generated-original/

# v5 authoring copies; reviewed deliverables are in output/v5.
/docs/v5-work/packages/
/docs/v5-report-work/*.docx
/docs/v5-report-work/native-pass*.pdf
/docs/v5-report-work/render-pass*/
/docs/v5-report-work/*.html
/docs/v5-work/*-local.txt

# v5 independent local acceptance: keep verification evidence, exclude duplicates.
/docs/v5-local-acceptance-20261022/unpacked/
/docs/v5-local-acceptance-20261022/*.jar
/docs/v5-local-acceptance-20261022/*.docx
/docs/v5-local-acceptance-20261022/*.html
/docs/v5-local-acceptance-20261022/docker-prepare.log
/docs/v5-local-acceptance-20261022/docker-roundtrip.log
/docs/v5-local-acceptance-20261022/docker-roundtrip/source-image-app.jar
/docs/v5-local-acceptance-20261022/docker-roundtrip/original-containers.*
/docs/v5-local-acceptance-20261022/docker-roundtrip/final-containers.txt

# Local v7 image transport and runtime snapshots; retain scripts and real evidence.
/docs/v7-work/*.tar
/docs/v7-work/baseline-containers.jsonl
/docs/v7-work/renderer-probe/
/docs/v6-submission-audit-20261022/inspection-copy.docx
/docs/v6-submission-audit-20261022/inspection.html
